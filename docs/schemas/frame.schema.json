{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "osie/frame.schema.json",
 "title": "OSIE intent frame (osie parse --json; 'frame' in osie ask --json)",
 "type": "object",
 "required": [
  "intent",
  "confidence",
  "parser",
  "target",
  "entities",
  "constraints",
  "observations",
  "unavailable_observations",
  "capabilities",
  "ambiguous",
  "validation_errors"
 ],
 "additionalProperties": false,
 "properties": {
  "intent": {
   "enum": [
    "top_cpu",
    "top_memory",
    "diagnose_cpu",
    "diagnose_memory",
    "diagnose_slow",
    "process_cpu",
    "process_memory",
    "process_info",
    "process_tree",
    "system_info",
    "cpu_topology",
    "memory_status",
    "disk_usage",
    "network_status",
    "thermal_status",
    "explain_concept",
    "what_if",
    "container_throttle",
    "action_request",
    "kubernetes",
    "help",
    "unsupported",
    "list_processes",
    "cgroup_status",
    "cpu_capacity"
   ]
  },
  "confidence": {
   "type": "number",
   "minimum": 0,
   "maximum": 1
  },
  "parser": {
   "type": "string"
  },
  "target": {
   "type": "object",
   "required": [
    "kind"
   ],
   "additionalProperties": false,
   "properties": {
    "kind": {
     "enum": [
      "host",
      "process_name",
      "pid",
      "reference",
      "none"
     ]
    },
    "value": {
     "type": "string"
    },
    "ordinal": {
     "type": "integer"
    }
   }
  },
  "entities": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "constraints": {
   "type": "object",
   "required": [
    "read_only"
   ],
   "additionalProperties": false,
   "properties": {
    "read_only": {
     "const": true
    },
    "top_n": {
     "type": "integer",
     "minimum": 1,
     "maximum": 50
    }
   }
  },
  "action": {
   "enum": [
    "terminate",
    "set_priority",
    "set_affinity",
    "kernel_parameter",
    "cgroup_limit",
    "restart_service",
    "network_config",
    "kubernetes_patch",
    "generic_change",
    "file_delete",
    "firewall_config",
    "container_control"
   ]
  },
  "concept": {
   "type": "string"
  },
  "observations": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "unavailable_observations": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "capabilities": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^(observe|act)\\."
   }
  },
  "safety": {
   "enum": [
    "directive",
    "explanation",
    "past_event",
    "hypothetical",
    "quoted_mention"
   ]
  },
  "override_attempt": {
   "const": true
  },
  "change": {
   "type": "object",
   "required": [
    "resource",
    "op",
    "value"
   ],
   "additionalProperties": false,
   "properties": {
    "resource": {
     "enum": [
      "cpu_quota",
      "cpuset"
     ]
    },
    "op": {
     "enum": [
      "set",
      "add",
      "multiply"
     ]
    },
    "value": {
     "type": "number"
    }
   }
  },
  "ambiguous": {
   "type": "boolean"
  },
  "clarification": {
   "type": "string"
  },
  "unsupported_reason": {
   "type": "string"
  },
  "validation_errors": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "temporal": {
   "type": "object",
   "required": [
    "kind",
    "metric",
    "rank_processes"
   ],
   "properties": {
    "kind": {
     "enum": [
      "trend",
      "onset",
      "recovery"
     ]
    },
    "metric": {
     "enum": [
      "cpu",
      "memory",
      "memory_pressure",
      "overall"
     ]
    },
    "window_s": {
     "type": "integer"
    },
    "rank_processes": {
     "type": "boolean"
    }
   }
  },
  "latency_us": {
   "type": "number"
  }
 },
 "allOf": [
  {
   "if": {
    "properties": {
     "intent": {
      "const": "action_request"
     }
    }
   },
   "then": {
    "required": [
     "action"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "intent": {
      "not": {
       "const": "action_request"
      }
     }
    }
   },
   "then": {
    "properties": {
     "capabilities": {
      "items": {
       "pattern": "^observe\\."
      }
     }
    },
    "not": {
     "required": [
      "action"
     ]
    }
   }
  }
 ]
}